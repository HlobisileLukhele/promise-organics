PORT=5000
NODE_ENV=development

# Supabase
# URL format: https://[project-ref].supabase.co  (NOT the dashboard URL)
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key from: Supabase Dashboard → Settings → API → service_role (secret)
# It starts with eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... (NOT the sb_publishable_ anon key)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# JWT
JWT_SECRET=replace-with-a-strong-random-secret

# PayFast
PAYFAST_MERCHANT_ID=your-payfast-merchant-id
PAYFAST_MERCHANT_KEY=your-payfast-merchant-key
PAYFAST_PASSPHRASE=your-payfast-passphrase
PAYFAST_SANDBOX=true

# Email (Gmail + App Password)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
CONTACT_RECEIVER_EMAIL=jeniselukhele@gmail.com

# Anthropic — get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# URLs
CLIENT_URL=http://localhost:3000,http://localhost:5173
BACKEND_URL=http://localhost:5000
